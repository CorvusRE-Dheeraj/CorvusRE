# Normalize line endings to LF for all text files, regardless of which OS
# checks them out or edits them -- without this, every commit from a
# Windows checkout warns "LF will be replaced by CRLF" (git's default
# core.autocrlf=true behavior on Windows), which doesn't affect what's
# actually committed but is pure noise on every single commit.
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF; everything else stays LF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets -- never touched by line-ending normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
