# Supabase project credentials — real user sign-up / sign-in and all project storage.
# Get these from your Supabase project: Project Settings > API.
# VITE_SUPABASE_ANON_KEY is the public "anon" / publishable key — safe to ship in
# the client bundle; access is enforced by the Row Level Security policies in
# supabase/schema.sql, not by keeping the key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — Google Places for address suggestions. If unset, address search
# falls back to keyless OpenStreetMap / Nominatim (works, lower US coverage).
# Get one from Google Cloud Console with the Places API (New) enabled.
VITE_GOOGLE_MAPS_API_KEY=
